# ─── Clario Backend — Environment Variables ─────────────────────────────
# Copy this file to .env and fill in real values.
#   cp .env.example .env
#
# .env is listed in .gitignore and will NOT be committed.
# ────────────────────────────────────────────────────────────────────────

# Port the server listens on (default: 5000)
PORT=5000

# n8n webhook URL for lead capture
# Replace with your actual n8n webhook URL (find it in your n8n workflow).
# Example: http://localhost:5678/webhook/your-webhook-id
N8N_LEAD_WEBHOOK_URL=http://localhost:5678/webhook-test/613389df-b18c-42dc-9cf1-37cdf0982bf2
